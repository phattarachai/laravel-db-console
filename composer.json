{
    "name": "phattarachai/laravel-db-console",
    "description": "An in-app web DB client for Laravel — browse tables and run guarded SQL, without Adminer.",
    "keywords": [
        "laravel",
        "database",
        "console",
        "adminer",
        "postgres",
        "inertia"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Phattarachai Chaimongkol",
            "email": "phatchai28@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^2.0|^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.8|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Phattarachai\\DbConsole\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phattarachai\\DbConsole\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phattarachai\\DbConsole\\DbConsoleServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    }
}
